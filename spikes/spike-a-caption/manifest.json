{
  "manifest_version": 3,
  "name": "YouTube Caption Acquisition Spike Harness",
  "version": "1.0.0",
  "description": "Disposable MV3 harness for SPIKE-A-CAPTION caption acquisition feasibility",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/watch*"
      ],
      "js": [
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/extractor/player-probe-injected.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
